# AI Providers Configuration
# 1. Bytez AI
BYTEZ_API_KEY=your_bytez_api_key
BYTEZ_MODEL=Qwen/Qwen3-4B
EXPO_PUBLIC_BYTEZ_API_KEY=your_bytez_api_key
EXPO_PUBLIC_BYTEZ_MODEL=Qwen/Qwen3-4B

# 2. OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=cohere/north-mini-code:free
EXPO_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key
EXPO_PUBLIC_OPENROUTER_MODEL=cohere/north-mini-code:free

# 3. Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key
EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-lite-latest

# 4. NVIDIA NIM API (https://integrate.api.nvidia.com/v1)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
EXPO_PUBLIC_NVIDIA_API_KEY=your_nvidia_api_key
EXPO_PUBLIC_NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# 5. Supabase Cloud
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
